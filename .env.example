# Required
ANTHROPIC_API_KEY=sk-ant-...

# Required — Supabase (get from Supabase Dashboard → Settings → API)
SUPABASE_URL=https://msxjcjzmfruizbgkssxo.supabase.co
SUPABASE_SERVICE_KEY=eyJ...  # service_role key (NOT anon key)

# Required — Resend HTTPS email service (used for password reset, etc.).
# Railway blocks outbound SMTP on all standard ports, so transactional email
# goes via Resend's HTTPS API. Get the key at https://resend.com/api-keys
# (free tier: 3,000 emails/month).
RESEND_API_KEY=re_...
# Verified sender on Resend. In sandbox mode (no verified sending domain) use
# onboarding@resend.dev — but Resend will only deliver to the email you
# verified on signup. For production, verify your sending domain on Resend
# (DNS records) and switch to noreply@yourdomain.com.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Required — origin where the frontend lives. Used as the base URL in
# transactional email links (e.g. password reset callback). Must match the
# actual deployment per environment.
FRONTEND_URL=https://jobflow-website-beaa.vercel.app

# Optional — Telegram channel (currently UNUSED; env vars kept for legacy code paths)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — Email response checking via IMAP (separate from transactional Resend send).
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_IMAP_SERVER=imap.gmail.com

# Admin allowlist — comma-separated emails bypass tier limits + cover-letter rate limit.
ADMIN_EMAILS=

# Per-user rate limit on cover letter generation
RATE_LIMIT_LETTERS_PER_DAY=50
# false = soft mode (count only, no 429); true = hard mode (block at limit)
RATE_LIMIT_ENFORCE=false
