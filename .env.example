# Mirrors the sections in config.py — keep them in sync when adding new vars.

# =============================================================================
# AUTH — Supabase (REQUIRED)
# =============================================================================
# Get from Supabase Dashboard → Settings → API.
SUPABASE_URL=https://msxjcjzmfruizbgkssxo.supabase.co
SUPABASE_SERVICE_KEY=eyJ...  # service_role key (NOT anon key)


# =============================================================================
# AI — Anthropic Claude (REQUIRED)
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-...


# =============================================================================
# EMAIL — Resend transactional (REQUIRED for password reset)
# =============================================================================
# Railway blocks outbound SMTP, so transactional email goes via Resend HTTPS.
# Get the key at https://resend.com/api-keys (free tier: 3,000 emails/month).
RESEND_API_KEY=re_...
# Verified sender. In sandbox (no verified domain) leave empty — code defaults
# to onboarding@resend.dev (delivers only to email verified on Resend account).
# For production, verify a domain on Resend and set noreply@yourdomain.com.
RESEND_FROM_EMAIL=


# =============================================================================
# EMAIL — Gmail IMAP (OPTIONAL, inbox-checking flow only)
# =============================================================================
# Separate from Resend transactional. Used by modules/email_parser.py to scan
# inbox for recruiter responses. EMAIL_PASSWORD must be a Gmail app password.
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_IMAP_SERVER=imap.gmail.com


# =============================================================================
# FRONTEND — base URL for transactional email links (REQUIRED)
# =============================================================================
FRONTEND_URL=https://hiredrop.io


# =============================================================================
# TIERS / RATE LIMITS
# =============================================================================
# Comma-separated emails bypass tier limits + cover-letter rate limit.
ADMIN_EMAILS=

# Cover letter daily rate limit. Soft = count only; hard = 429 on overage.
RATE_LIMIT_LETTERS_PER_DAY=120
RATE_LIMIT_ENFORCE=false


# =============================================================================
# OBSERVABILITY — stall watch (OPTIONAL, on by default)
# =============================================================================
# Where "campaign running but nothing applied" alerts are emailed (via Resend).
# Empty → the warn line still lands in the user's activity log, no email is sent.
ALERT_EMAIL=
STALL_WATCH_ENABLED=true
STALL_WATCH_INTERVAL_SECONDS=300
STALL_FIRST_MINUTES=45
STALL_GAP_MINUTES=30


# =============================================================================
# BILLING — Stripe (subscriptions)
# =============================================================================
# From Stripe Dashboard → Developers → API keys / Webhooks. Create one recurring
# Price per paid plan and put the price IDs below. Leave empty until ready —
# the billing endpoints return 503 until STRIPE_SECRET_KEY is set.
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_WEEKLY=price_...   # ~$9/week recurring Price
STRIPE_PRICE_MONTHLY=price_...  # ~$29/month recurring Price
