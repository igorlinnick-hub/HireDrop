{
  "manifest_version": 3,
  "name": "HireDrop \u2014 Auto-Apply on Indeed, ZipRecruiter, Greenhouse",
  "short_name": "HireDrop",
  "version": "1.7.5",
  "description": "Auto-apply on Indeed, ZipRecruiter, Greenhouse, Lever & Ashby with your resume and an AI-written cover letter.",
  "author": "HireDrop",
  "homepage_url": "https://hiredrop.io",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "activeTab",
    "debugger"
  ],
  "host_permissions": [
    "https://web-production-db45.up.railway.app/*",
    "https://*.indeed.com/*",
    "https://*.ziprecruiter.com/*",
    "https://*.greenhouse.io/*",
    "https://job-boards.eu.greenhouse.io/*",
    "https://boards.eu.greenhouse.io/*",
    "https://hiredrop.io/*",
    "https://msxjcjzmfruizbgkssxo.supabase.co/*",
    "https://jobs.lever.co/*",
    "https://*.ashbyhq.com/*",
    "https://*.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.indeed.com/*",
        "https://*.ziprecruiter.com/*",
        "https://*.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*",
        "https://boards.eu.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.ashbyhq.com/*",
        "https://*.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://hiredrop.io/*"
      ],
      "js": [
        "ping.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}