{
  "manifest_version": 3,
  "name": "HireDrop — Auto-Apply on Indeed",
  "short_name": "HireDrop",
  "version": "1.3.0",
  "description": "Auto-fill Indeed applications with your resume + an AI-written cover letter. Stop, start, and limit campaigns from one dashboard.",
  "author": "HireDrop",
  "homepage_url": "https://hiredrop.io",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "https://web-production-db45.up.railway.app/*",
    "https://*.indeed.com/*",
    "https://hiredrop.io/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.indeed.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://hiredrop.io/*"
      ],
      "js": ["ping.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
