{
  "manifest_version": 3,
  "name": "JobFlow — Auto-Apply on Indeed",
  "short_name": "JobFlow",
  "version": "1.3.0",
  "description": "Auto-fill Indeed applications with your resume + an AI-written cover letter. Stop, start, and limit campaigns from one dashboard.",
  "author": "JobFlow",
  "homepage_url": "https://jobflow-website-beaa.vercel.app",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "alarms",
    "notifications",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://web-production-db45.up.railway.app/*",
    "https://*.indeed.com/*",
    "https://jobflow-website.vercel.app/*",
    "https://jobflow-website-beaa.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.indeed.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:*/*",
        "https://web-production-db45.up.railway.app/*",
        "https://jobflow-website.vercel.app/*",
        "https://jobflow-website-beaa.vercel.app/*"
      ],
      "js": ["ping.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
